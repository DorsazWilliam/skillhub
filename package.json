{
  "name": "skillhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --infer-origin-from-routes=false",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "parity": "node scripts/check-parity.mjs",
    "gen": "node scripts/gen-client.mjs",
    "setup": "node scripts/setup.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "build": "node scripts/build-web.mjs",
    "pretest": "node scripts/build-web.mjs",
    "predeploy": "node scripts/build-web.mjs",
    "predev": "node scripts/build-web.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts --project=e2e",
    "screenshots": "playwright test -c e2e/playwright.config.ts --project=screenshots",
    "build:node": "node scripts/build-node.mjs",
    "start": "node --no-warnings --enable-source-maps dist/server.mjs",
    "test:node": "vitest run -c vitest.node.config.ts",
    "test:pg": "vitest run -c vitest.node.config.ts --mode pg",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@cloudflare/puppeteer": "^2.0.1",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@hono/node-server": "^2.1.11",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tanstack/react-query": "^5.108.0",
    "aws4fetch": "^1.0.20",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.19",
    "jose": "^6.2.17",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.4",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@electric-sql/pglite": "^0.6.0",
    "@playwright/test": "^1.65.1",
    "@types/diff": "^7.0.2",
    "@types/mdast": "^4.0.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": ">=22"
  }
}
