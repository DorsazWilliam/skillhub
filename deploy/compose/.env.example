# Public URL people and agents use (behind your TLS proxy). The Entra redirect URI is BASE_URL/auth/callback.
BASE_URL=https://skills.example.com

# Microsoft Entra ID app registration (docs/ENTRA.md)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=
ENTRA_ALLOWED_TENANTS=
ALLOWED_EMAIL_DOMAINS=
ALLOW_GUESTS=false
OWNER_EMAILS=you@example.com

# 32+ random bytes: openssl rand -hex 32
SESSION_SECRET=

MCP_MAX_SCOPES=read,write,publish,manage
CATALOG_IN_TOOL_DESC=true

# bundled.yml only
POSTGRES_PASSWORD=
S3_SECRET=

# external.yml only: the client's database and bucket
# DATABASE_URL=postgres://skillhub:password@db.internal:5432/skillhub
# S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# S3_BUCKET=skillhub
# S3_REGION=eu-west-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Optional: screenshots for render_prototype from a Chromium container, e.g. ws://chromium:3000
# BROWSER_WS_URL=
